<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Hgvd.Avalonia.Controls"
        xmlns:vm="using:Hgvd.Avalonia.ViewModels"
        x:Class="Hgvd.Avalonia.Views.MainWindow"
        x:Name="Root"
        Title="红果视频下载器"
        Width="1180" Height="780" MinWidth="1020" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource TextDarkBrush}"
        Background="{DynamicResource AppBgBrush}"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        CanResize="True"
        PointerMoved="Window_PointerMoved"
        PointerReleased="Window_PointerReleased">

  <Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ══════════════ 顶栏 ══════════════ -->
      <Border Grid.Row="0" Height="62" Background="{DynamicResource BrandGradient}"
              PointerPressed="TopBar_PointerPressed">
        <DockPanel Margin="18,8,18,8" LastChildFill="False">
          <!-- 右：窗口三键（先占位，永远贴右上角） -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                      VerticalAlignment="Stretch" Margin="0,0,-18,0">
            <ctl:WindowButton x:Name="BtnWinMin" Kind="Minimize" Click="BtnWinMin_Click" />
            <ctl:WindowButton x:Name="BtnWinMax" Kind="Maximize" Click="BtnWinMax_Click" />
            <ctl:WindowButton x:Name="BtnWinClose" Kind="Close" Click="BtnWinClose_Click" />
          </StackPanel>

          <!-- 右：授权（★ 启动不自动取，点这个按钮才按当前源去取） -->
          <Button x:Name="BtnLogin" DockPanel.Dock="Right" Content="获取授权"
                  Classes="modern" Click="BtnLogin_Click"
                  ToolTip.Tip="按当前内容源去 MuMu 里读对应 App 的登录态：&#10;· 红果 → 红果 App&#10;· 兴趣岛 → 兴趣岛 App&#10;已有本机缓存时不会启动模拟器。" />
          <TextBlock x:Name="LblAuth" DockPanel.Dock="Right" Text="授权：未获取"
                     Foreground="{DynamicResource BrandSubBrush}"
                     VerticalAlignment="Center" Margin="14,0" MaxWidth="200"
                     TextTrimming="CharacterEllipsis" />

          <Border x:Name="BrandBox" DockPanel.Dock="Left" Background="Transparent"
                  Cursor="Hand" VerticalAlignment="Center"
                  ToolTip.Tip="单击查看「关于」 · 拖动可移动窗口 · 双击最大化">
            <StackPanel>
              <TextBlock Text="红果视频下载器" FontSize="16" FontWeight="SemiBold"
                         Foreground="White" />
              <TextBlock Text="红果收藏夹 · 兴趣岛课程 · 批量导出通用 MP4" FontSize="11"
                         Foreground="{DynamicResource BrandSubBrush}" />
            </StackPanel>
          </Border>

          <TextBlock DockPanel.Dock="Left" Text="下载目录" Foreground="White"
                     VerticalAlignment="Center" Margin="24,0,0,0" />
          <TextBox x:Name="EdOut" DockPanel.Dock="Left" Width="250" Margin="8,0,0,0"
                   Classes="round"
                   VerticalAlignment="Center"
                   LostFocus="EdOut_LostFocus"
                   KeyDown="EdOut_KeyDown"
                   ToolTip.Tip="改完直接回车或点别处即生效" />
          <Button x:Name="BtnBrowse" DockPanel.Dock="Left" Content="浏览…" Margin="6,0,0,0"
                  Classes="modern" Click="BtnBrowse_Click" />
        </DockPanel>
      </Border>

      <!-- ══════════════ 主体 ══════════════ -->
      <Grid Grid.Row="1" Margin="14,12,14,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- 提示条 -->
        <Border x:Name="Banner" Grid.Row="0" IsVisible="False" CornerRadius="8"
                Padding="12,9" Margin="0,0,0,10" BorderThickness="1"
                Background="{DynamicResource BannerInfoBg}"
                BorderBrush="{DynamicResource BannerInfoBd}">
          <TextBlock x:Name="TxtBanner" TextWrapping="Wrap"
                     Foreground="{DynamicResource BannerInfoFg}" />
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="320,*">

          <!-- ── 左：内容源列表（收藏夹 / 我的课程） ── -->
          <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

              <!-- 源切换 -->
              <Border Grid.Row="0" Background="#E9EEF6" CornerRadius="8" Padding="3">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="TabHongguo" GroupName="src" Classes="src"
                               Content="红果视频" IsChecked="True" Checked="Src_Checked" />
                  <RadioButton x:Name="TabXqd" GroupName="src" Classes="src"
                               Content="兴趣岛课程" Checked="Src_Checked" />
                </StackPanel>
              </Border>

              <!-- 搜索（两源各自一个框，切换显示） -->
              <TextBox x:Name="EdSearch" Grid.Row="1" Classes="round" Margin="0,8,0,6"
                       Watermark="搜索剧名…"
                       TextChanged="EdSearch_TextChanged"
                       ToolTip.Tip="按剧名筛选（留空 = 显示全部）" />
              <TextBox x:Name="EdCampSearch" Grid.Row="1" Classes="round" Margin="0,8,0,6"
                       IsVisible="False"
                       Watermark="筛选营名…"
                       TextChanged="EdCampSearch_TextChanged"
                       ToolTip.Tip="按营名筛选（留空 = 显示全部）" />

              <!-- 列表（红果收藏夹 / 兴趣岛营列表，叠在同一格） -->
              <Grid Grid.Row="2">
                <ListBox x:Name="LstShelf"
                         Classes="shelf"
                         BorderThickness="0" Background="Transparent"
                         SelectionMode="Single"
                         SelectionChanged="LstShelf_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                  Click="ShkChk_Click" />
                        <TextBlock Grid.Column="1" Text="{Binding Display}"
                                   Width="{Binding TitleWidth}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="2" Text="{Binding MetaText}"
                                   Width="66"
                                   FontSize="10" Foreground="#9AA6B5"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <ListBox x:Name="LstCamps" IsVisible="False"
                         Classes="shelf"
                         BorderThickness="0" Background="Transparent"
                         SelectionMode="Single"
                         DoubleTapped="LstCamps_DoubleTapped">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Background="Transparent" ToolTip.Tip="{Binding ToolTip}"
                            Height="30">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                  Click="CampChk_Click" />
                        <TextBlock Grid.Column="1" Text="{Binding Display}"
                                   Width="{Binding TitleWidth}"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                        <Border Grid.Column="2" Background="#F1F4F8" CornerRadius="8"
                                Padding="7,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Badge}" FontSize="10.5"
                                     Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>

              <!-- 手动链接（折叠；自动发现之外的兜底入口） -->
              <Grid x:Name="ManualPanel" Grid.Row="3" IsVisible="False"
                    RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
                <Border Grid.Row="0" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource CardBorderBrush}" Background="White">
                  <TextBox x:Name="EdLinks" BorderThickness="0" Background="Transparent"
                           AcceptsReturn="True" TextWrapping="Wrap" Height="86"
                           FontFamily="Consolas, Courier New, monospace" FontSize="12"
                           VerticalContentAlignment="Top" Padding="8,6"
                           TextChanged="EdLinks_TextChanged"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           Watermark="一行一条：&#10;课名 | https://…/xxx.m3u8&#10;https://…"
                           ToolTip.Tip="支持「课名 | 链接」「课名&#9;链接」「只有链接」；# 开头是注释" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,6,0,0">
                  <Button Grid.Column="0" x:Name="BtnImport" Content="导入…"
                          Classes="modern" Padding="8,4" FontSize="12"
                          Click="BtnImportLinks_Click"
                          ToolTip.Tip="导入清单文件：.txt / .json（可多选；links.json + names.json 会按 fileId 合并课名）" />
                  <Button Grid.Column="1" x:Name="BtnAddLinks" Content="加入清单" Margin="6,0,0,0"
                          Classes="primary" Padding="10,4" FontSize="12"
                          Click="BtnAddLinks_Click" />
                  <TextBlock Grid.Column="2" Text="链接里的 sign 有有效期，过期会 403"
                             FontSize="10.5" Foreground="{DynamicResource HintBrush}"
                             Margin="8,0,0,0"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Button Grid.Column="3" x:Name="BtnClearLinks" Content="清空"
                          Classes="modern" Padding="8,4" FontSize="12" Margin="6,0,0,0"
                          Click="BtnClearLinks_Click"
                          ToolTip.Tip="只清空上面的输入框，不动已加入清单的任务" />
                </Grid>
                <TextBlock Grid.Row="2" x:Name="LblLinkCount" Text="0 条"
                           FontSize="10.5" Foreground="{DynamicResource HintBrush}"
                           Margin="2,4,0,0" />
              </Grid>

              <!-- 底栏：按源切换 -->
              <Grid Grid.Row="4" Margin="0,8,0,0" ColumnDefinitions="Auto,Auto,*,Auto">
                <Button x:Name="BtnRefresh" Grid.Column="0" Content="刷新"
                        Classes="modern" Click="BtnRefresh_Click" />
                <Button x:Name="BtnRefreshCamps" Grid.Column="0" Content="刷新课程"
                        Classes="modern" IsVisible="False" Click="BtnRefreshCamps_Click" />
                <CheckBox x:Name="ChkAllCamps" Grid.Column="1" Content="全选" IsVisible="False"
                          IsThreeState="True" MinHeight="0" Margin="8,0,0,0"
                          VerticalAlignment="Center" Click="ChkAllCamps_Click"
                          ToolTip.Tip="勾选全部营（会逐个拉课表，比较慢）" />
                <Button x:Name="BtnRescanCamps" Grid.Column="2" Content="重扫" IsVisible="False"
                        Classes="modern" Padding="8,3" Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        Click="BtnRescanCamps_Click"
                        ToolTip.Tip="按磁盘上已有的成品重判状态（≥1MB 且时长对得上才算已存在）" />
                <Button x:Name="BtnManualToggle" Grid.Column="3" Content="链接…"
                        Classes="modern" Padding="8,3" IsVisible="False"
                        Click="BtnManualToggle_Click"
                        ToolTip.Tip="手动粘贴课程链接（自动发现之外的兜底）" />
                <TextBlock x:Name="LblHint" Grid.Column="3" Margin="10,0,0,0"
                           Classes="muted"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right" />
              </Grid>
            </Grid>
          </Border>

          <!-- ── 右：两源共用的下载清单 ── -->
          <Border Grid.Column="1" Classes="card">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- ★★ 用 Grid 而**不是** DockPanel：窗口一窄，右侧按钮会被挤出可视区 -->
              <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="下载清单 ·" Classes="section" />
                  <ctl:MarqueeControl x:Name="Marquee" Margin="4,0,0,0"
                                      Width="150" ToolTip.Tip="当前正在处理的条目标题" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <ComboBox x:Name="CmbQuality" Width="140" Margin="3,0,0,0"
                            VerticalAlignment="Center"
                            SelectionChanged="CmbQuality_SelectionChanged" />
                  <Button x:Name="BtnRun" Content="下载" Margin="3,0,0,0"
                          Classes="primary" Click="BtnRun_Click"
                          ToolTip.Tip="空闲时 = 开始下载（有选中行只下选中，否则下所有待下载/失败）；&#10;下载中 = 暂停（两源都生效，保留进度与分片）；暂停中 = 继续。" />
                  <Button x:Name="BtnHistory" Content="历史" Margin="3,0,0,0"
                          Classes="modern" Click="BtnHistory_Click"
                          ToolTip.Tip="查看两源的下载历史（最近 500 条，同一成品只留一条）" />
                  <Button x:Name="BtnCache" Content="提取App缓存" Margin="6,0,0,0"
                          Classes="modern" Click="BtnCache_Click"
                          ToolTip.Tip="从红果 App 提取已播放的视频缓存（标准 MP4）。&#10;只覆盖已缓存的内容，先在 App 里播放并等它下完再提取。" />
                  <!-- ★ 「自动抓剧」「抓流」两个入口都已**删除**（2026-11-22 复核后裁掉）。
                       理由：两者都靠外部手段拿直链，与「只下收藏夹里的教材/合集类视频」
                       的目标口径不符，且抓流因红果接口改版（2026-11-21 22:20）
                       已失效 —— 匹配的是旧接口 multi_video_model/*，新响应也没有数字 vid。
                       相关代码一并删除，不留「恢复入口」的路。 -->

                </StackPanel>
              </Grid>

              <!-- 视图筛选：与清单同宽的一行，避免和右侧按钮抢位置 -->
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0"
                          VerticalAlignment="Center" Spacing="2">
                <RadioButton x:Name="RbAll" GroupName="EpView"
                             Classes="pill" Content="全部" IsChecked="True"
                             Checked="RbView_Checked" />
                <RadioButton x:Name="RbPending" GroupName="EpView"
                             Classes="pill" Content="待下载" Checked="RbView_Checked" />
                <RadioButton x:Name="RbRunning" GroupName="EpView"
                             Classes="pill" Content="下载中" Checked="RbView_Checked" />
                <RadioButton x:Name="RbDone" GroupName="EpView"
                             Classes="pill" Content="已完成" Checked="RbView_Checked" />
                <RadioButton x:Name="RbFailed" GroupName="EpView"
                             Classes="pill" Content="失败" Checked="RbView_Checked" />
              </StackPanel>

              <Border Grid.Row="2" Margin="0,8,0,0" CornerRadius="8"
                      Background="White" BorderBrush="{DynamicResource CardBorderBrush}"
                      BorderThickness="1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <!-- ★ 表头与数据行用**同样的列定义**，标题列宽度由代码算好同时写进两边 -->
                  <Border Grid.Row="0" Classes="thead" Padding="6,0">
                    <Grid Height="28" ColumnDefinitions="58,46,Auto,54,126,72,58,122">
                      <TextBlock Grid.Column="0" Text="状态" Classes="thead" />
                      <TextBlock Grid.Column="1" Text="来源" Classes="thead" />
                      <TextBlock x:Name="HdTitle" Grid.Column="2" Text="标题" Classes="thead"
                                 Margin="0,0,6,0" />
                      <TextBlock Grid.Column="3" Text="时长" Classes="thead" />
                      <TextBlock Grid.Column="4" Text="大小" Classes="thead" />
                      <TextBlock Grid.Column="5" Text="速度" Classes="thead" />
                      <TextBlock Grid.Column="6" Text="剩余" Classes="thead" />
                      <TextBlock Grid.Column="7" Text="进度" Classes="thead" />
                    </Grid>
                  </Border>

                  <ListBox x:Name="LstEpisodes" Grid.Row="1"
                           Classes="ep"
                           BorderThickness="0" Background="Transparent"
                           SelectionMode="Multiple"
                           DoubleTapped="LstEpisodes_DoubleTapped"
                           KeyDown="LstEpisodes_KeyDown"
                           ToolTip.Tip="双击某一行 = 只下这一条（不看勾选、不受筛选影响）&#10;右键 = 下载 / 重下 / 复制 / 打开 / 移出；Delete 键移出"
                           ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <!-- 正常行 -->
                          <Grid Height="26" ColumnDefinitions="58,46,Auto,54,126,72,58,122"
                                IsVisible="{Binding IsEpisode}">
                            <Grid.ContextMenu>
                              <ContextMenu DataContext="{Binding}" Opening="EpMenu_Opening">
                                <MenuItem Header="下载这一条" Tag="{Binding}"
                                          Click="MenuDownloadRow_Click" />
                                <MenuItem Header="重新下载（清缓存）" Tag="{Binding}"
                                          Click="MenuRetryRow_Click" />
                                <Separator />
                                <MenuItem Header="复制链接" Tag="{Binding}"
                                          IsVisible="{Binding IsXqd}"
                                          Click="MenuCopyUrlRow_Click" />
                                <MenuItem Header="复制标题" Tag="{Binding}"
                                          Click="MenuCopyTitleRow_Click" />
                                <MenuItem Header="打开所在文件夹" Tag="{Binding}"
                                          Click="MenuOpenFolderRow_Click" />
                                <Separator />
                                <MenuItem Header="移出清单" Tag="{Binding}"
                                          Click="MenuRemoveRow_Click" />
                              </ContextMenu>
                            </Grid.ContextMenu>
                            <Border Grid.Column="0" IsVisible="{Binding ShowPill}"
                                    Background="{Binding StatePillBg}"
                                    BorderBrush="{Binding StatePillBorder}"
                                    BorderThickness="0.5" CornerRadius="9"
                                    Padding="8,2" HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding StateWord}" FontSize="11" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding SourceText}"
                                       FontSize="10.5" Foreground="#8494A8"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Title}"
                                       Width="{Binding TitleWidth}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Title}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="3" Text="{Binding DurationText}"
                                       Foreground="#8494A8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding SizeText}"
                                       Foreground="#8494A8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{Binding SpeedText}"
                                       Foreground="#8494A8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="{Binding EtaText}"
                                       Foreground="#8494A8" VerticalAlignment="Center" />
                            <ctl:ProgressCell Grid.Column="7"
                                              Percent="{Binding Percent}"
                                              Text="{Binding ProgressText}"
                                              Fill="{Binding ProgressFill}"
                                              VerticalAlignment="Center" />
                          </Grid>

                          <!-- 分组标题行：多部剧/多个营累计时把它们分开 -->
                          <Border IsVisible="{Binding IsGroupHeader}" Height="26"
                                  Margin="0,6,0,2" Padding="10,0" CornerRadius="6"
                                  Background="#F1F4FA">
                            <TextBlock Text="{Binding HeaderText}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#4A5A74"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <TextBlock Grid.Row="3" x:Name="LblEpHint" Margin="2,6,0,0"
                         Classes="muted" />
            </Grid>
          </Border>
        </Grid>

        <!-- ── 运行日志（全宽，两源共用） ── -->
        <Border Grid.Row="2" Classes="card" Margin="0,10,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False">
              <TextBlock Text="运行日志" Classes="section" />
              <Button x:Name="BtnClearLog" DockPanel.Dock="Right" Content="清空"
                      Classes="modern" Click="BtnClearLog_Click" Padding="8,3" />
            </DockPanel>
            <TextBox x:Name="TxtLog" Grid.Row="1" Margin="0,6,0,0" Classes="log" />
          </Grid>
        </Border>
      </Grid>

      <!-- ══════════════ 底栏 ══════════════ -->
      <Border Grid.Row="2" Height="28" Background="{DynamicResource StatusBgBrush}"
              BorderBrush="#E0E5EE" BorderThickness="0,1,0,0">
        <DockPanel Margin="14,0">
          <TextBlock x:Name="LblVersion" DockPanel.Dock="Right" VerticalAlignment="Center"
                     Text="v—" Foreground="#7C8AA0" FontSize="11"
                     Margin="12,0,0,0" />
          <TextBlock x:Name="LblStatus" DockPanel.Dock="Left" Text="就绪"
                     VerticalAlignment="Center" Classes="muted" />
          <TextBlock x:Name="LblRight" VerticalAlignment="Center" Margin="10,0,0,0"
                     Classes="muted" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- ══════════════ 缩放热区 ══════════════ -->
    <Grid ZIndex="100">
      <Border Name="GripLeft" Width="6" HorizontalAlignment="Left" Background="Transparent"
              PointerPressed="Grip_PointerPressed" />
      <Border Name="GripRight" Width="6" HorizontalAlignment="Right" Background="Transparent"
              PointerPressed="Grip_PointerPressed" />
      <Border Name="GripTop" Height="6" VerticalAlignment="Top" Background="Transparent"
              PointerPressed="Grip_PointerPressed" />
      <Border Name="GripBottom" Height="6" VerticalAlignment="Bottom" Background="Transparent"
              PointerPressed="Grip_PointerPressed" />
      <Border Name="GripTopLeft" Width="16" Height="16" HorizontalAlignment="Left"
              VerticalAlignment="Top" Background="Transparent"
              PointerPressed="Grip_PointerPressed" />
      <Border Name="GripTopRight" Width="16" Height="16" HorizontalAlignment="Right"
              VerticalAlignment="Top" Background="Transparent"
              PointerPressed="Grip_PointerPressed" />
      <Border Name="GripBottomLeft" Width="16" Height="16" HorizontalAlignment="Left"
              VerticalAlignment="Bottom" Background="Transparent"
              PointerPressed="Grip_PointerPressed" />
      <Border Name="GripBottomRight" Width="16" Height="16" HorizontalAlignment="Right"
              VerticalAlignment="Bottom" Background="Transparent"
              PointerPressed="Grip_PointerPressed" />
    </Grid>
  </Grid>
</Window>
