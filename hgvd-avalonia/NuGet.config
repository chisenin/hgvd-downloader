<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- ★ 国内镜像优先：国内网络下 api.nuget.org 常被 302 到 nuget.azure.cn -->
    <clear />
    <add key="nuget-cn" value="https://nuget.azure.cn/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
