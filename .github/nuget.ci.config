<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ CI 专用的 NuGet 源配置。
  仓库里 hgvd-avalonia/NuGet.config 把 nuget.azure.cn 放在第一位（国内快，
  而国内网络下 api.nuget.org 常被 302 到它）；GitHub 托管的 runner 在海外，
  用这个只走 nuget.org 的配置更快更稳。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
