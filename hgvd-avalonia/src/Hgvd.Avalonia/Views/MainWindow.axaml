<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Hgvd.Avalonia.Controls"
        x:Class="Hgvd.Avalonia.Views.MainWindow"
        Title="红果视频下载器  v1.1.1"
        Width="1180" Height="780" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource TextDarkBrush}"
        Background="{DynamicResource AppBgBrush}"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        CanResize="True"
        PointerMoved="Window_PointerMoved"
        PointerReleased="Window_PointerReleased">

  <Grid>
    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ══════════════ 顶栏 ══════════════ -->
    <!-- ★ 整条顶栏都可以拖动窗口（原来只有左上角 logo 那一小块能拖，
         鼠标一移出那块就断了，下载时更明显）。 -->
    <Border Grid.Row="0" Height="62" Background="{DynamicResource BrandGradient}"
            PointerPressed="TopBar_PointerPressed">
      <DockPanel Margin="18,8,18,8" LastChildFill="False">
        <Border x:Name="BrandBox" DockPanel.Dock="Left" Background="Transparent"
                Cursor="Hand" VerticalAlignment="Center"
                ToolTip.Tip="单击查看「关于」 · 拖动可移动窗口 · 双击最大化">
          <StackPanel>
            <TextBlock Text="红果视频下载器" FontSize="16" FontWeight="SemiBold"
                       Foreground="White" />
            <TextBlock Text="从收藏夹批量下载教学视频为通用 MP4" FontSize="11"
                       Foreground="{DynamicResource BrandSubBrush}" />
          </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Left" Text="下载目录" Foreground="White"
                   VerticalAlignment="Center" Margin="24,0,0,0" />
        <TextBox x:Name="EdOut" DockPanel.Dock="Left" Width="250" Margin="8,0,0,0"
                 Classes="round"
                 VerticalAlignment="Center"
                 LostFocus="EdOut_LostFocus"
                 KeyDown="EdOut_KeyDown"
                 ToolTip.Tip="改完直接回车或点别处即生效" />
        <Button x:Name="BtnBrowse" DockPanel.Dock="Left" Content="浏览…" Margin="6,0,0,0"
                Classes="modern" Click="BtnBrowse_Click" />

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                    VerticalAlignment="Stretch" Margin="0,0,-18,0">
          <ctl:WindowButton x:Name="BtnWinMin" Kind="Minimize" Click="BtnWinMin_Click" />
          <ctl:WindowButton x:Name="BtnWinMax" Kind="Maximize" Click="BtnWinMax_Click" />
          <ctl:WindowButton x:Name="BtnWinClose" Kind="Close" Click="BtnWinClose_Click" />
        </StackPanel>

        <Button x:Name="BtnEnv" DockPanel.Dock="Right" Content="环境检查"
                Classes="modern" Click="BtnEnv_Click"
                ToolTip.Tip="检查 ffmpeg / ffprobe 等运行环境依赖。" />
        <Button x:Name="BtnLogin" DockPanel.Dock="Right" Content="重新授权"
                Classes="modern" Click="BtnLogin_Click"
                ToolTip.Tip="从 MuMu 模拟器重新读取红果 App 登录态。" />
        <TextBlock x:Name="LblAuth" DockPanel.Dock="Right" Text="授权：检查中…"
                   Foreground="{DynamicResource BrandSubBrush}"
                   VerticalAlignment="Center" Margin="14,0" />
      </DockPanel>
    </Border>

    <!-- ══════════════ 主体 ══════════════ -->
    <Grid Grid.Row="1" Margin="14,12,14,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 提示条 -->
      <Border x:Name="Banner" Grid.Row="0" IsVisible="False" CornerRadius="8"
              Padding="12,9" Margin="0,0,0,10" BorderThickness="1"
              Background="{DynamicResource BannerInfoBg}"
              BorderBrush="{DynamicResource BannerInfoBd}">
        <TextBlock x:Name="TxtBanner" TextWrapping="Wrap"
                   Foreground="{DynamicResource BannerInfoFg}" />
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── 左栏：收藏夹 ── -->
        <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
              <TextBlock Text="收藏夹" Classes="section" />
            </DockPanel>

            <TextBox x:Name="EdSearch" Grid.Row="1" Classes="round" Margin="0,8,0,6"
                     Watermark="搜索剧名…"
                     TextChanged="EdSearch_TextChanged"
                     ToolTip.Tip="按剧名筛选（留空 = 显示全部）" />

            <ListBox x:Name="LstShelf" Grid.Row="2"
                     Classes="shelf"
                     BorderThickness="0" Background="Transparent"
                     SelectionMode="Single"
                     SelectionChanged="LstShelf_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <!-- ★ 用 Grid 两列：DockPanel 会把右侧的类型文字挤没 -->
                  <Grid Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- ★ 勾选即把该剧的分集「追加」进右栏下载清单（取消勾选则移出） -->
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              Click="ShkChk_Click" />
                    <TextBlock Grid.Column="1" Text="{Binding Display}"
                               Width="{Binding TitleWidth}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="2" Text="{Binding MetaText}"
                               Width="66"
                               FontSize="10" Foreground="#9AA6B5"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
              <Button x:Name="BtnRefresh" DockPanel.Dock="Left" Content="刷新"
                      Classes="modern" Click="BtnRefresh_Click" />
              <TextBlock x:Name="LblHint" DockPanel.Dock="Right" Margin="10,0,0,0"
                         Classes="muted"
                         TextTrimming="CharacterEllipsis"
                         HorizontalAlignment="Right" />
            </DockPanel>
          </Grid>
        </Border>

        <!-- ── 右栏：分集列表 + 日志 ── -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Classes="card" Margin="0,0,0,10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                  <TextBlock Text="下载清单 ·" Classes="section" />
                  <!-- ★ 跑马灯要限宽：它有内容时会把右边的
                       画质/下载/停止/提取缓存按钮挤出窗口 -->
                  <ctl:MarqueeControl x:Name="Marquee" Margin="4,0,0,0"
                                      Width="150" ToolTip.Tip="当前剧目的第一集标题" />
                  <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                              VerticalAlignment="Center">
                    <!-- ★ 用户反馈：「待下载 / 已完成 / 失败」三个筛选标签
                         毫无意义，已去掉（红框标注处）。
                         筛选逻辑（MatchEpView / ApplyEpView）保留在代码里，
                         以后想加回来很快。 -->
                    <RadioButton x:Name="RbAll" GroupName="EpView"
                                 Classes="pill" Content="全部" IsChecked="True"
                                 Checked="RbView_Checked" />
                  </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <ComboBox x:Name="CmbQuality" Width="140" Margin="3,0,0,0"
                            VerticalAlignment="Center"
                            SelectionChanged="CmbQuality_SelectionChanged" />
                  <Button x:Name="BtnRun" Content="下载" Margin="3,0,0,0"
                          Classes="primary" Click="BtnRun_Click"
                          ToolTip.Tip="有选中行则只下选中的；没选中则下清单里所有待下载的&#10;（左边勾选几部剧，它们的分集会依次追加到清单里）" />
                  <Button x:Name="BtnStop" Content="停止" Margin="3,0,0,0"
                          Classes="modern danger" Click="BtnStop_Click" IsEnabled="False" />
                  <Button x:Name="BtnCache" Content="提取App缓存" Margin="6,0,0,0"
                          Classes="modern" Click="BtnCache_Click"
                          ToolTip.Tip="从 MuMu 里的红果 App 提取已播放的视频缓存（标准 MP4）。&#10;★ 服务端播放接口限流时，这是唯一还能出片的路径。" />
                </StackPanel>
              </DockPanel>

              <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="8"
                      Background="White" BorderBrush="{DynamicResource CardBorderBrush}"
                      BorderThickness="1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <!-- ★ 表头与数据行用**同样的列定义**，
                       标题列的宽度由代码算好后同时写进两边 → 永远对齐。 -->
                  <Border Grid.Row="0" Classes="thead" Padding="6,0">
                    <Grid Height="28" ColumnDefinitions="58,Auto,54,126,74,136">
                      <TextBlock Grid.Column="0" Text="状态" Classes="thead" />
                      <TextBlock x:Name="HdTitle" Grid.Column="1" Text="标题" Classes="thead"
                                 Margin="0,0,6,0" />
                      <TextBlock Grid.Column="2" Text="时长" Classes="thead" />
                      <TextBlock Grid.Column="3" Text="大小" Classes="thead" />
                      <TextBlock Grid.Column="4" Text="速度" Classes="thead" />
                      <TextBlock Grid.Column="5" Text="进度" Classes="thead" />
                    </Grid>
                  </Border>

                  <ListBox x:Name="LstEpisodes" Grid.Row="1"
                           Classes="ep"
                           BorderThickness="0" Background="Transparent"
                           SelectionMode="Multiple"
                           ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <!-- 正常分集行 -->
                          <Grid Height="26" ColumnDefinitions="58,Auto,54,126,74,136"
                                IsVisible="{Binding IsEpisode}">
                            <!-- 状态胶囊 -->
                            <Border Grid.Column="0" IsVisible="{Binding ShowPill}"
                                    Background="{Binding StatePillBg}"
                                    BorderBrush="{Binding StatePillBorder}"
                                    BorderThickness="0.5" CornerRadius="9"
                                    Padding="8,2" HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding StateWord}" FontSize="11" />
                            </Border>
                            <!-- 标题 -->
                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                       Width="{Binding TitleWidth}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Title}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                       Foreground="#8494A8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding SizeText}"
                                       Foreground="#8494A8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding SpeedText}"
                                       Foreground="#8494A8" VerticalAlignment="Center" />
                            <!-- 进度：渐变条 + 居中百分比 -->
                            <ctl:ProgressCell Grid.Column="5"
                                              Percent="{Binding Percent}"
                                              Text="{Binding ProgressText}"
                                              Fill="{Binding ProgressFill}"
                                              VerticalAlignment="Center" />
                          </Grid>

                          <!-- ★ 分组标题行：多部剧累计时把每部剧分开，序号各归各的 -->
                          <Border IsVisible="{Binding IsGroupHeader}" Height="26"
                                  Margin="0,6,0,2" Padding="10,0" CornerRadius="6"
                                  Background="#F1F4FA">
                            <TextBlock Text="{Binding HeaderText}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#4A5A74"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <TextBlock Grid.Row="2" x:Name="LblEpHint" Margin="2,6,0,0"
                         Classes="muted" />
            </Grid>
          </Border>

          <!-- 日志 -->
          <Border Grid.Row="1" Classes="card" Margin="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock Text="运行日志" Classes="section" />
                <Button x:Name="BtnClearLog" DockPanel.Dock="Right" Content="清空"
                        Classes="modern" Click="BtnClearLog_Click" Padding="8,3" />
              </DockPanel>
              <TextBox x:Name="TxtLog" Grid.Row="1" Margin="0,6,0,0" Classes="log" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- ══════════════ 底栏 ══════════════ -->
    <Border Grid.Row="2" Height="28" Background="{DynamicResource StatusBgBrush}"
            BorderBrush="#E0E5EE" BorderThickness="0,1,0,0">
      <DockPanel Margin="14,0">
        <!-- ★ 右侧固定放版本号（用户要求）；
             「已完成 N / M」挪到左边、跟在状态文字后面。 -->
        <TextBlock x:Name="LblVersion" DockPanel.Dock="Right" VerticalAlignment="Center"
                   Text="v1.1.1" Foreground="#7C8AA0" FontSize="11"
                   Margin="12,0,0,0" />
        <TextBlock x:Name="LblStatus" DockPanel.Dock="Left" Text="就绪"
                   VerticalAlignment="Center" Classes="muted" />
        <TextBlock x:Name="LblRight" VerticalAlignment="Center" Margin="10,0,0,0"
                   Classes="muted" />
      </DockPanel>
    </Border>
  </Grid>
      <!-- ══════════════ 缩放热区 ══════════════ -->
      <!-- ★ 自绘窗口（SystemDecorations=None）没有系统边框，
           这圈透明热区负责把「拖边」变成「改窗口大小」。 -->
      <Grid ZIndex="100">
        <Border Name="GripLeft" Width="6" HorizontalAlignment="Left" Background="Transparent"
                PointerPressed="Grip_PointerPressed" />
        <Border Name="GripRight" Width="6" HorizontalAlignment="Right" Background="Transparent"
                PointerPressed="Grip_PointerPressed" />
        <Border Name="GripTop" Height="6" VerticalAlignment="Top" Background="Transparent"
                PointerPressed="Grip_PointerPressed" />
        <Border Name="GripBottom" Height="6" VerticalAlignment="Bottom" Background="Transparent"
                PointerPressed="Grip_PointerPressed" />
        <Border Name="GripTopLeft" Width="16" Height="16" HorizontalAlignment="Left"
                VerticalAlignment="Top" Background="Transparent"
                PointerPressed="Grip_PointerPressed" />
        <Border Name="GripTopRight" Width="16" Height="16" HorizontalAlignment="Right"
                VerticalAlignment="Top" Background="Transparent"
                PointerPressed="Grip_PointerPressed" />
        <Border Name="GripBottomLeft" Width="16" Height="16" HorizontalAlignment="Left"
                VerticalAlignment="Bottom" Background="Transparent"
                PointerPressed="Grip_PointerPressed" />
        <Border Name="GripBottomRight" Width="16" Height="16" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Background="Transparent"
                PointerPressed="Grip_PointerPressed" />
      </Grid>
  </Grid>
</Window>
